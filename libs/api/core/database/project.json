{
  "name": "api-core-database",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/core/database/src",
  "projectType": "library",
  "tags": [
    "platform:api",
    "scope:core",
    "type:api-infrastructure"
  ],
  "targets": {
    "prisma-generate": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/src/generated/prisma"
      ],
      "options": {
        "command": "prisma generate",
        "env": {
          "DATABASE_URL": "postgresql://daylo:daylo-local@localhost:5433/daylo"
        }
      }
    },
    "prisma-migrate-deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "prisma migrate deploy"
      }
    },
    "prisma-verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/api/core/database/scripts/verify-schema.mjs"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": [
        "prisma-generate"
      ],
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "coverage/libs/api/core/database"
      }
    }
  }
}
