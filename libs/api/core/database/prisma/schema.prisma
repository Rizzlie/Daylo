generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserAccessStatus {
  PENDING @map("pending")
  ACTIVE  @map("active")

  @@map("user_access_status")
}

enum ThemePreference {
  SYSTEM @map("system")
  LIGHT  @map("light")
  DARK   @map("dark")

  @@map("theme_preference")
}

enum InvitationStatus {
  PENDING   @map("pending")
  ACCEPTED  @map("accepted")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")

  @@map("invitation_status")
}

model User {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleSubject String           @unique(map: "users_google_subject_key") @map("google_subject") @db.VarChar(255)
  email         String           @unique(map: "users_email_key") @db.VarChar(320)
  displayName   String           @map("display_name") @db.VarChar(200)
  accessStatus  UserAccessStatus @default(PENDING) @map("access_status")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  preferences     UserPreferences?
  sessions        Session[]
  ownedGroups     Group[]          @relation("GroupOwner")
  memberships     Membership[]
  invitationsSent Invitation[]     @relation("InvitationInviter")
  createdTasks    Task[]           @relation("TaskCreator")
  completedTasks  Task[]           @relation("TaskCompleter")

  @@map("users")
}

model UserPreferences {
  userId                  String          @id @map("user_id") @db.Uuid
  theme                   ThemePreference @default(SYSTEM)
  playfulGreetingsEnabled Boolean         @default(true) @map("playful_greetings_enabled")
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_preferences_user_id_fkey")

  @@map("user_preferences")
}

model Session {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  tokenHash     String   @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  csrfTokenHash String   @unique(map: "sessions_csrf_token_hash_key") @map("csrf_token_hash") @db.Char(64)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "sessions_user_id_fkey")

  @@index([userId, expiresAt], map: "sessions_user_id_expires_at_idx")
  @@map("sessions")
}

model OAuthTransaction {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateHash          String   @unique(map: "oauth_transactions_state_hash_key") @map("state_hash") @db.Char(64)
  browserBindingHash String   @map("browser_binding_hash") @db.Char(64)
  nonce              String   @unique(map: "oauth_transactions_nonce_key") @db.VarChar(255)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([browserBindingHash, expiresAt], map: "oauth_transactions_browser_expires_at_idx")
  @@map("oauth_transactions")
}

model Group {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(120)
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       User         @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict, map: "groups_owner_id_fkey")
  memberships Membership[]
  invitations Invitation[]
  tasks       Task[]

  @@index([ownerId], map: "groups_owner_id_idx")
  @@map("groups")
}

model Membership {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict, map: "memberships_group_id_fkey")
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict, map: "memberships_user_id_fkey")

  @@unique([groupId, userId], map: "memberships_group_id_user_id_key")
  @@index([userId], map: "memberships_user_id_idx")
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String           @map("group_id") @db.Uuid
  email       String           @db.VarChar(320)
  invitedById String           @map("invited_by_id") @db.Uuid
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  resolvedAt  DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  group     Group @relation(fields: [groupId], references: [id], onDelete: Restrict, map: "invitations_group_id_fkey")
  invitedBy User  @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict, map: "invitations_invited_by_id_fkey")

  @@index([email, status, expiresAt], map: "invitations_email_status_expires_at_idx")
  @@index([groupId, status], map: "invitations_group_id_status_idx")
  @@map("invitations")
}

model Task {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdById   String    @map("created_by_id") @db.Uuid
  groupId       String?   @map("group_id") @db.Uuid
  title         String    @db.VarChar(200)
  description   String?   @db.Text
  scheduledDate DateTime  @map("scheduled_date") @db.Date
  scheduledTime DateTime? @map("scheduled_time") @db.Time(0)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  completedById String?   @map("completed_by_id") @db.Uuid
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict, map: "tasks_created_by_id_fkey")
  group       Group? @relation(fields: [groupId], references: [id], onDelete: Restrict, map: "tasks_group_id_fkey")
  completedBy User?  @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: Restrict, map: "tasks_completed_by_id_fkey")

  @@index([createdById, scheduledDate], map: "tasks_created_by_id_scheduled_date_idx")
  @@index([groupId, scheduledDate], map: "tasks_group_id_scheduled_date_idx")
  @@index([scheduledDate, scheduledTime, createdAt], map: "tasks_scheduled_order_idx")
  @@index([completedAt], map: "tasks_completed_at_idx")
  @@map("tasks")
}
