{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [
    "platform:api",
    "scope:app",
    "type:app"
  ],
  "targets": {
    "build": {
      "dependsOn": [
        "^build",
        {
          "projects": [
            "api-core-database"
          ],
          "target": "prisma-generate"
        }
      ]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "coverage/apps/api"
      },
      "dependsOn": [
        {
          "projects": [
            "api-core-database"
          ],
          "target": "prisma-generate"
        }
      ]
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/api/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "openapi-build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "api-core-database"
          ],
          "target": "prisma-generate"
        }
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/tools/openapi-export"
      ],
      "options": {
        "cwd": "apps/api",
        "command": "webpack-cli build --config webpack.openapi.config.js",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "openapi-export": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "openapi-build"
      ],
      "outputs": [
        "{workspaceRoot}/docs/api/openapi.json"
      ],
      "options": {
        "command": "node dist/tools/openapi-export/main.js"
      }
    },
    "openapi-validate": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "openapi-export"
      ],
      "options": {
        "command": "node apps/api/scripts/validate-openapi.mjs"
      }
    },
    "e2e-build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "api-core-database"
          ],
          "target": "prisma-generate"
        }
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/tools/e2e-api"
      ],
      "options": {
        "cwd": "apps/api",
        "command": "webpack-cli build --config webpack.e2e.config.js",
        "env": {
          "NODE_ENV": "test"
        }
      }
    }
  }
}
