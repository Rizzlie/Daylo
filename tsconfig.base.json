{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@daylo/api/core/configuration": [
        "./libs/api/core/configuration/src/index.ts"
      ],
      "@daylo/api/core/database": [
        "./libs/api/core/database/src/index.ts"
      ],
      "@daylo/api/core/transactions/contracts": [
        "./libs/api/core/transactions/contracts/src/index.ts"
      ],
      "@daylo/shared/schemas": [
        "./libs/shared/schemas/src/index.ts"
      ],
      "@daylo/api/auth/feature": [
        "./libs/api/auth/feature/src/index.ts"
      ],
      "@daylo/web/shared/api-client": [
        "./libs/web/shared/api-client/src/index.ts"
      ],
      "@daylo/api/auth/data-access": [
        "./libs/api/auth/data-access/src/index.ts"
      ],
      "@daylo/api/users/contracts": [
        "./libs/api/users/contracts/src/index.ts"
      ],
      "@daylo/api/users/data-access": [
        "./libs/api/users/data-access/src/index.ts"
      ],
      "@daylo/api/users/feature": [
        "./libs/api/users/feature/src/index.ts"
      ],
      "@daylo/api/groups/contracts": [
        "./libs/api/groups/contracts/src/index.ts"
      ],
      "@daylo/api/groups/data-access": [
        "./libs/api/groups/data-access/src/index.ts"
      ],
      "@daylo/api/groups/feature": [
        "./libs/api/groups/feature/src/index.ts"
      ],
      "@daylo/api/core/identity/contracts": [
        "./libs/api/core/identity/contracts/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
