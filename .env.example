NODE_ENV=development
PORT=3000
# Installation-wide IANA time zone, shared by the API and browser. Defaults to Europe/Warsaw.
DAYLO_TIME_ZONE=Europe/Warsaw
DATABASE_URL=postgresql://daylo:daylo-local@localhost:5433/daylo
FRONTEND_ORIGIN=http://localhost:4200
# Verified Google email allowed to bootstrap active owner access.
INITIAL_OWNER_EMAIL=

POSTGRES_DB=daylo
POSTGRES_USER=daylo
POSTGRES_PASSWORD=daylo-local
POSTGRES_PORT=5433

# Google Auth Platform: OAuth client type Web application.
# Keep real credentials in ignored .env.local or .env; all three values are required by the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4200/api/auth/google/callback
# Required independent 32-byte random key (64 hex characters). Keep it secret.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OAUTH_PKCE_ENCRYPTION_KEY=
